# Copie ce fichier en .env.local et complète-le. Ne commite jamais .env.local.
# Projet Supabase hébergé de DÉVELOPPEMENT (jamais la production) : les tests y créent puis suppriment des comptes.

# Tableau de bord > Project Settings > API (ou bouton « Connect »)
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
# Clé publique : « publishable key » (sb_publishable_…) ou, à défaut, l'ancienne clé « anon »
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Côté serveur et tests uniquement, jamais dans le navigateur :
# « secret key » (sb_secret_…) ou, à défaut, l'ancienne clé « service_role »
SUPABASE_SERVICE_ROLE_KEY=

# Bouton « Connect » > Connection string > « Session pooler » (compatible IPv4), mot de passe inclus.
# Sert à appliquer les migrations (pnpm db:push) et à lancer les tests RLS (pnpm test:db).
SUPABASE_DB_URL=postgresql://postgres.<ref>:<mot-de-passe>@aws-0-eu-west-3.pooler.supabase.com:5432/postgres

# Facultatif : génération des types (pnpm db:types). Compte > Access Tokens.
SUPABASE_ACCESS_TOKEN=

# PostgreSQL qui remplace Supabase (docs/MIGRATION_POSTGRES.md). En local : `pnpm db:local start`.
# Migrations : pnpm db:migrate ; types Kysely : pnpm db:types:pg.
DATABASE_URL=postgresql://postgres@localhost:54329/finpret

# Fichiers privés (PDF des kits et relevés d'associations), rangés sur le disque du serveur.
# Par défaut .data/files en local ; sur le VPS, le volume Docker monté (ex. /data/files), sauvegardé avec la base.
FILES_DIR=

# Better Auth (remplace Supabase Auth). Secret : `openssl rand -base64 32` ; il chiffre aussi les clés TOTP du back-office.
# L'URL publique de l'application vient de APP_URL. Sans RESEND_API_KEY, le lien de connexion s'affiche dans le terminal.
BETTER_AUTH_SECRET=
# Google Cloud > API et services > Identifiants > ID client OAuth (application Web).
# URI de redirection autorisée : <APP_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple (drapeau FEATURES.appleSignIn) : URI de redirection <APP_URL>/api/auth/callback/apple
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Notifications Web Push (M9) : `pnpm dlx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@example.com
# Secret partagé avec le planificateur (appel de /api/cron/notify toutes les 15 min) : `openssl rand -hex 32`
CRON_SECRET=
# E-mail de repli (Resend). Sans clé, seuls les envois push partent.
RESEND_API_KEY=
EMAIL_FROM=Fin Prêt <rappels@example.com>

# Import de recettes par modèle de langage (M8b)
ANTHROPIC_API_KEY=

# Surveillance des erreurs (Sentry), facultative : sans DSN, rien n'est envoyé.
SENTRY_DSN
NEXT_PUBLIC_SENTRY_DSN

# Adresse publique de l'application (liens des e-mails, QR codes, Stripe).
APP_URL=https://finpret.app

# Paiement (Stripe, mode TEST en développement). `pnpm stripe:setup` crée les prix et le coupon et affiche leurs identifiants.
STRIPE_SECRET_KEY
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY
STRIPE_WEBHOOK_SECRET
STRIPE_PRICE_MONTHLY
STRIPE_PRICE_YEARLY
STRIPE_COUPON_ASSOCIATION

# IBAN des associations : clé AES-256-GCM de 32 octets en hexadécimal (`openssl rand -hex 32`).
IBAN_ENCRYPTION_KEY

# Alerte e-mail quand un webhook Stripe échoue.
ALERT_EMAIL

# Mentions de facture et pages légales (statut juridique de l'éditeur à confirmer).
COMPANY_NAME
COMPANY_ID
COMPANY_VAT
