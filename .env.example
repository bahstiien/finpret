# Copie ce fichier en .env.local (développement) ou en .env.production sur le VPS, et complète-le. Jamais dans Git.
# Mise en service de la production : docs/MISE_EN_SERVICE.md.

# PostgreSQL. En local : `pnpm db:local start` (base sans Docker sur le port 54329).
# Migrations : pnpm db:migrate ; types Kysely : pnpm db:types. Sur le VPS, fixé par deploy/docker-compose.yml.
DATABASE_URL=postgresql://postgres@localhost:54329/finpret

# Fichiers privés (PDF des kits et relevés d'associations), rangés sur le disque du serveur.
# Par défaut .data/files en local ; sur le VPS, le volume Docker /data/files (fixé par deploy/docker-compose.yml).
FILES_DIR=

# Adresse publique de l'application (connexion, liens des e-mails, QR codes, Stripe). En local : http://localhost:3000
APP_URL=https://finpret.app

# Better Auth. Secret : `openssl rand -base64 32` ; il chiffre aussi les clés TOTP du back-office (ne jamais le changer en production).
# Sans BREVO_API_KEY en développement, le lien de connexion s'affiche dans le terminal de `pnpm dev`.
BETTER_AUTH_SECRET=
# Google Cloud > API et services > Identifiants > ID client OAuth (application Web).
# URI de redirection autorisée : <APP_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple (drapeau FEATURES.appleSignIn) : URI de redirection <APP_URL>/api/auth/callback/apple
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# E-mails (Brevo, API transactionnelle) : liens de connexion, invitations, rappels. Domaine de EMAIL_FROM authentifié chez Brevo (SPF, DKIM).
BREVO_API_KEY=
EMAIL_FROM=Fin Prêt <rappels@example.com>
# Lien de désinscription en un clic des e-mails non transactionnels : `openssl rand -hex 32` (à défaut, CRON_SECRET).
UNSUBSCRIBE_SECRET=

# Notifications Web Push (M9) : `pnpm dlx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@example.com
# Secret des tâches planifiées (/api/cron/*, appelées par deploy/cron.sh) : `openssl rand -hex 32`
CRON_SECRET=

# Import de recettes par modèle de langage (M8b)
ANTHROPIC_API_KEY=

# Surveillance des erreurs (Sentry), facultative : sans DSN, rien n'est envoyé.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Paiement (Stripe, mode TEST en développement). `pnpm stripe:setup` crée les prix et le coupon et affiche leurs identifiants.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
STRIPE_COUPON_ASSOCIATION=

# IBAN des associations : clé AES-256-GCM de 32 octets en hexadécimal (`openssl rand -hex 32`).
IBAN_ENCRYPTION_KEY=

# Alerte e-mail quand un webhook Stripe échoue.
ALERT_EMAIL=

# Mentions de facture et pages légales (statut juridique de l'éditeur à confirmer).
COMPANY_NAME=
COMPANY_ID=
COMPANY_VAT=
