# Copie ce fichier en .env.local et complète-le. Ne commite jamais .env.local.

# Supabase (valeurs locales affichées par `pnpm exec supabase status`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Côté serveur uniquement (scripts de seed, Edge Functions) — jamais dans le navigateur
SUPABASE_SERVICE_ROLE_KEY=

# Notifications Web Push (M9) : `pnpm dlx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@example.com

# Import de recettes par modèle de langage (M8b)
ANTHROPIC_API_KEY=
