      "blue-soft": "#4d96ff",
      "blue-ink": "#17151f",
      "pink-soft": "#ff6b9d",
      "pink-ink": "#17151f",
      "yellow-soft": "#fff6d6",
      "peach": "#ff8c42",
      "peach-ink": "#17151f",
      "chip": "#fff6d6",
      "violet-soft": "#fff6d6",
      "violet-strong": "#4b2fc9",
      "nav": "#17151f",
      "on-nav": "#fff8e7",
      "green-soft": "#1fa85a",
      "green-ink": "#17151f",
      "green-strong": "#17803f",
      "cream-ink": "#7a5a00",
      "banane": "#ffd23f",
      "on-banane": "#17151f",
      "on-violet": "#ffffff",
      "blue": "#4d96ff",
      "pink": "#ff6b9d",
      "yellow": "#fff6d6",
      "on-fill": "#17151f",
      "ink-fixed": "#17151f",
      "focus": "#7a5af8",
      "kit-band": "#7a5af8",
      "on-kit-band": "#ffffff",
      "kit-offer": "#ffd23f",
      "on-kit-offer": "#17151f",
      "kit-annot": "#e5007e",
      "on-kit-annot": "#ffffff"
    },
    "dark": {
      "bg": "#181818",
      "surface": "#1f1f1f",
      "ink": "#f3f1f8",
      "muted": "#a6a2b4",
      "line": "#313131",
      "blue-soft": "#1d2b44",
      "blue-ink": "#a9c8f5",
      "pink-soft": "#3a1d29",
      "pink-ink": "#f5a3bb",
      "yellow-soft": "#352d14",
      "peach": "#3d2419",
      "peach-ink": "#f5a582",
