      "green-soft": "#183324",
      "green-ink": "#86efac",
      "green-strong": "#4ade80",
      "cream-ink": "#ffd86b"
    }
  },
  "role": {
    "$comment": "Rôles et domaines (design system « Fin Prêt Néo »). Alias de couleurs : un domaine = un aplat, banane = cta (une seule action principale par écran), violet = sel (sélection). Texte sur aplat : on-fill, sauf on-violet (16 px gras minimum) et on-nav.",
    "menu": "var(--violet)",
    "on-menu": "var(--on-violet)",
    "courses": "var(--green)",
    "on-courses": "var(--on-fill)",
    "stock": "var(--blue)",
    "on-stock": "var(--on-fill)",
    "progres": "var(--banane)",
    "on-progres": "var(--on-fill)",
    "session": "var(--peach)",
    "on-session": "var(--on-fill)",
    "alerte": "var(--pink)",
    "on-alerte": "var(--on-fill)",
    "cta": "var(--banane)",
    "on-cta": "var(--on-banane)",
    "sel": "var(--violet)",
    "on-sel": "var(--on-violet)",
    "info": "var(--blue)",
    "on-info": "var(--on-fill)",
    "success": "var(--green)",
    "on-success": "var(--on-fill)",
    "warning": "var(--banane)",
    "on-warning": "var(--on-fill)",
    "danger": "var(--pink)",
    "on-danger": "var(--on-fill)"
  },
  "touch": {
    "min": "44px",
    "main": "52px",
    "session": "60px",
    "note": "Cibles tactiles : min = toute cible, main = bouton md et champs, session = bouton lg et navigation de la session guidée."
  },
  "duration": {
    "fast": "90ms",
    "stamp": "360ms",
    "note": "fast = survol et clic ; stamp = tampon qui s'abat."
  },
  "tilt": {
    "l": "-1.5deg",
    "1": "-1deg",
    "r": "1.5deg",
    "2": "2deg",
    "sticker": "-3deg",
    "note": "Une ou deux pièces inclinées par écran, jamais un texte long."
  },
  "zIndex": {
    "timers": 25,
    "nav": 30,
    "coach": 40,
    "sheet": 60
  },
  "font": {
    "display": "Archivo Black",
    "sans": "Space Grotesk",
    "mono": "Space Mono",
    "note": "Titres en capitales (Archivo Black), texte Space Grotesk, chiffres et métadonnées Space Mono."
  },
  "radius": {
    "r0": "0px",
    "r1": "2px",
    "r2": "4px",
    "card": "0.25rem",
    "sheet": "0.25rem",
    "pill": "9999px",
    "note": "Rayon 0 à 4 px ; la pilule est réservée aux badges."
  },
  "motion": {
    "ease": "steps(2)",
    "layout": "90ms",
    "color": "90ms",
    "reveal": "90ms",
    "note": "Décalages mécaniques, pas d'easing doux ; aucun fondu ; prefers-reduced-motion coupe tout."
  },
  "spacing": {
    "steps": [
      0,
      2,
      4,
      8,
      12,
      16,
      24,
      32,
      40,
      48,
      64,
      80,
      96
    ],
    "unit": "px",
    "note": "Seules valeurs autorisées pour marges, espacements et gouttières. Classes Tailwind : 0, 0.5, 1, 2, 3, 4, 6, 8, 10, 12, 16, 20, 24."
  },
  "typeScale": {
    "steps": [
      "xs 12/16",
      "sm 14/20",
      "base 16/24",
      "lg 18/28",
      "xl 20/28",
      "2xl 24/32",
      "3xl 30/36",
      "4xl 36/40",
      "5xl 48/1",
      "6xl 60/1",
      "7xl 72/1",
      "8xl 96/1",
      "9xl 128/1"
    ],
    "note": "Aucune taille arbitraire : on arrondit au palier inférieur."
  },
  "border": {
    "mobile": "2px",
    "desktop": "3px",
    "note": "Bordure encre partout : 2 px mobile, 3 px desktop (≥ 900 px)."
  },
  "shadow": {
    "sm": "2px",
    "base": "3px",
    "lg": "5px",
    "note": "Ombre dure décalée x = y, flou 0, couleur line ; sur desktop 3/6/9 px."
  }
}