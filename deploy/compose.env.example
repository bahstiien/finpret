# À copier sur le VPS en ~/finpret/.env (jamais dans Git). Lu par Docker Compose pour compléter docker-compose.yml.
# Le déploiement n'y modifie que la ligne APP_TAG.
# Mots de passe : `openssl rand -hex 32` (hexadécimal : sans caractère à échapper dans les URL de connexion).
# Ils ne servent qu'à la création du volume pgdata ; les changer ensuite exige un ALTER ROLE dans la base.

# Version de l'image de l'application (écrite par le workflow de déploiement).
APP_TAG=latest

# Propriétaire de la base (migrations, sauvegardes). Jamais utilisé par l'application.
POSTGRES_PASSWORD=

# Rôle de connexion de l'application (finpret_app), soumis à la RLS.
APP_DB_PASSWORD=
