{
  "name": "fin-pret",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=20.18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node -e \"require('fs').rmSync('.next-build',{recursive:true,force:true,maxRetries:20,retryDelay:500})\" && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "stripe:setup": "node scripts/stripe-setup.mjs",
    "tokens": "node scripts/tokens.mjs",
    "tokens:check": "node scripts/tokens.mjs --check",
    "seed": "tsx scripts/seed.ts",
    "backfill:progress": "tsx scripts/backfill-progress.ts",
    "test:db:lite": "node scripts/test-db-lite.mjs",
    "audit:lighthouse": "node scripts/lighthouse.mjs",
    "db:local": "node scripts/db-local.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:types": "node scripts/db-types.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.1",
    "@react-pdf/renderer": "^4.9.0",
    "@sentry/nextjs": "^11.8.0",
    "@serwist/next": "^9.5.13",
    "better-auth": "1.7.10",
    "kysely": "^0.29.7",
    "next": "15.5.28",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "stripe": "^23.0.0",
    "unpdf": "1.3.2",
    "web-push": "3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@electric-sql/pglite": "^0.5.10",
    "@electric-sql/pglite-pgtap": "^0.0.11",
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "3.6.4",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.28",
    "jsdom": "^30.1.3",
    "jsqr": "^1.4.0",
    "kysely-codegen": "^0.20.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.30",
    "prettier": "^3.9.10",
    "serwist": "^9.5.13",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
